<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WebDavShare.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WebDavShare"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Grid x:Name="AppTitleBar" Height="36" Grid.Row="0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                <FontIcon Glyph="&#xE8B7;" FontSize="14" Margin="0,0,8,0" />
                <TextBlock x:Name="TitleBarText" VerticalAlignment="Center"
                           Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>
        </Grid>

        <!-- 状态条：横跨整宽 -->
        <Border Grid.Row="1" Margin="16,4,16,0" Padding="16,10"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="6">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Ellipse x:Name="StatusDot" Grid.Column="0" Width="10" Height="10"
                         VerticalAlignment="Center" Fill="Gray" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusTitle"
                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Name="StatusDetail"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                            VerticalAlignment="Center" Margin="0,0,8,0">
                    <Button x:Name="CopyUrlButton" Click="OnCopyUrl"
                            >
                        <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                    </Button>
                    <Button x:Name="OpenBrowserButton" Click="OnOpenBrowser"
                            >
                        <FontIcon Glyph="&#xE774;" FontSize="14" />
                    </Button>
                    <Button x:Name="ExportCertButton" Click="OnExportCert"
                            >
                        <FontIcon Glyph="&#xE8D7;" FontSize="14" />
                    </Button>
                </StackPanel>

                <Button x:Name="ToggleButton" Grid.Column="3"
                        Style="{StaticResource AccentButtonStyle}"
                        MinWidth="104" Height="34" Click="OnToggleServer" />
            </Grid>
        </Border>

        <!-- 主体：左右两列，一屏放下不用滚动 -->
        <Grid Grid.Row="2" Margin="16,10,16,16" ColumnSpacing="10" RowSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="360" />
                <ColumnDefinition Width="2*" MinWidth="290" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="150" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 左上：共享文件夹 -->
            <Border Grid.Row="0" Grid.Column="0" Padding="16,12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="6">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <StackPanel>
                            <TextBlock x:Name="SharedFoldersLabel"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock x:Name="SharedFoldersHint"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6"
                                    HorizontalAlignment="Right" VerticalAlignment="Top">
                            <Button x:Name="AddShareButton" Click="OnAddShare">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE710;" FontSize="12" />
                                    <TextBlock x:Name="AddButtonText" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="RemoveShareButton" Click="OnRemoveShare" />
                        </StackPanel>
                    </Grid>

                    <ListView x:Name="ShareList" Grid.Row="1" SelectionMode="Single"
                              DoubleTapped="OnShareDoubleTapped"
                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                              BorderThickness="1" CornerRadius="4">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="MinHeight" Value="34" />
                                <Setter Property="Padding" Value="10,2" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:ShareItem">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" MinWidth="90" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE8B7;" FontSize="13"
                                              VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Name}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Path}"
                                               VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- 右上：设置 -->
            <Border Grid.Row="0" Grid.Column="1" Padding="16,10"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="6">
                <!-- 兜底滚动：小屏或超高 DPI 下右列仍可能放不下 -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              VerticalScrollMode="Auto" HorizontalScrollMode="Disabled">
                <StackPanel Spacing="6">
                    <TextBlock x:Name="ConnectionLabel"
                               Style="{StaticResource BodyStrongTextBlockStyle}" />

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <NumberBox x:Name="PortBox" Grid.Column="0" Value="8443"
                                   Minimum="1" Maximum="65535"
                                   SpinButtonPlacementMode="Hidden" />
                        <TextBox x:Name="UserBox" Grid.Column="1" />
                    </Grid>

                    <PasswordBox x:Name="PasswordBox" />

                    <!-- ToggleSwitch 的 Header + OnContent 会占三行高度，
                         这里用横向布局把标签放在开关左边，省下垂直空间。
                         IsOn 不在 XAML 里设：解析期触发 Toggled 时后面的控件还没建好。 -->
                    <Grid Margin="0,4,0,0">
                        <TextBlock x:Name="ReadOnlyLabel" VerticalAlignment="Center" />
                        <ToggleSwitch x:Name="ReadOnlySwitch" MinWidth="0"
                                      HorizontalAlignment="Right"
                                      OnContent="{x:Null}" OffContent="{x:Null}"
                                      Toggled="OnReadOnlyToggled" />
                    </Grid>
                    <TextBlock x:Name="ReadOnlyHint"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Margin="0,-6,0,0" TextWrapping="Wrap" />

                    <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                    <Grid>
                        <TextBlock x:Name="AutoStartLabel" VerticalAlignment="Center" />
                        <ToggleSwitch x:Name="AutoStartSwitch" MinWidth="0"
                                      HorizontalAlignment="Right" OnContent="{x:Null}" OffContent="{x:Null}"
                                      Toggled="OnAutoStartToggled" />
                    </Grid>

                    <ComboBox x:Name="AutoStartModeBox"
                              SelectedIndex="0" IsEnabled="False"
                              HorizontalAlignment="Stretch"
                              SelectionChanged="OnAutoStartModeChanged">
                    </ComboBox>

                    <CheckBox x:Name="MinimizeToTrayCheck"
                              IsChecked="True" MinHeight="0" Padding="8,3,0,3"
                              Checked="OnTraySettingChanged"
                              Unchecked="OnTraySettingChanged" />
                </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 下方：日志，横跨两列 -->
            <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Padding="16,10"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="6">
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <TextBlock x:Name="LogLabel"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                   VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" Spacing="8"
                                    HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="SecurityHintText" Visibility="Collapsed"
                                       
                                       VerticalAlignment="Center"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                            <Button x:Name="ClearLogButton" Click="OnClearLog" />
                        </StackPanel>
                    </Grid>

                    <ScrollViewer x:Name="LogScroller" Grid.Row="1" Height="104"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto"
                                  Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                  BorderThickness="1" CornerRadius="4" Padding="10,6">
                        <ItemsControl x:Name="LogList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:LogEntry">
                                    <TextBlock Text="{x:Bind Text}" Foreground="{x:Bind Brush}"
                                               FontFamily="Consolas" FontSize="12"
                                               TextWrapping="NoWrap" IsTextSelectionEnabled="True" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
